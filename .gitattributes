# 脚本必须 LF，否则 Linux runner 上 bash 会报 "$'\r': command not found"
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.py            text eol=lf
*.mjs           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
Dockerfile*     text eol=lf
*.service       text eol=lf
*.md            text eol=lf
