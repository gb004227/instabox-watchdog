# ═══════════════════════════════════════════
# 复制为 .env 后填写：cp .env.example .env
# 所有凭据只存在 .env（已 .dockerignore / .gitignore），不进镜像
# ═══════════════════════════════════════════

# —— 音箱对外地址（唯一必须改的一项）——
# 云服务器公网 IP 或已解析域名，带 http://，不带端口和结尾斜杠
PUBLIC_HOSTNAME=http://123.45.67.89

# —— 小米账号（MiGPT 与 xiaomusic 共用）——
MI_USER=125170
MI_PASS=你的小米账号密码
# 音箱 device id；留空 = xiaomusic 自动发现第一台设备
MI_DID=
# MiGPT 侧用来匹配音箱的显示名（米家 App 里的名字，必须完全一致）
MI_DID_NAME=Xiaomi 智能音箱 Pro
# 异地登录触发风控时才填（从 account.xiaomi.com 的 Cookie 里取 passToken）
MI_PASS_TOKEN=

# —— 大模型（OpenAI 兼容协议）——
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_API_KEY=sk-你的密钥

# —— 网易云（生成网络歌单 + 320k 直链解析）——
# music.163.com 登录后 F12 → Network → 任意请求 → Cookie 整段复制
NETEASE_COOKIE=
# 网易云账号 uid（歌单属于谁）
NETEASE_UID=118428391

# —— 控制台监听地址 ——
# 0.0.0.0 = 公网可直接访问；127.0.0.1 = 只走 SSH 隧道（更安全）
CONSOLE_BIND=0.0.0.0
