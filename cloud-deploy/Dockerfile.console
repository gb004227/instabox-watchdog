# MiGPT + Web 控制台 + 网易云直链代理（容器内监听 3000）
FROM node:20-slim

ENV TZ=Asia/Shanghai \
    PORT=3000 \
    HOST=0.0.0.0 \
    YTDLP_BIN=/usr/local/bin/yt-dlp \
    STREAM_BASE=http://console:3000/netease-stream

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip ffmpeg curl \
    && pip3 install --no-cache-dir --break-system-packages yt-dlp \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY xiaoai-migpt/package.json xiaoai-migpt/package-lock.json ./
RUN npm ci --omit=dev

COPY xiaoai-migpt/ ./
COPY entrypoint-console.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 3000
ENTRYPOINT ["/app/entrypoint.sh"]
