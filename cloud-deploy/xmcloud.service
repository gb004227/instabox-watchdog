[Unit]
Description=xiaomusic + MiGPT console (docker compose, /data/xmcloud)
Documentation=file:/data/xmcloud/CLOUD-DEPLOY.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/data/xmcloud
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
Restart=no

[Install]
WantedBy=multi-user.target
